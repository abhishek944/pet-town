{
  "formatVersion": 1,
  "id": "fern-potted-plant",
  "packVersion": "4",
  "clips": {
    "leaf-sway-step": {
      "asset": "walk.webp",
      "durationMs": 720,
      "role": "locomotion",
      "sourceFacing": "right",
      "mirror": true
    },
    "sprout-leaf": {
      "asset": "work.webp",
      "durationMs": 960,
      "role": "locomotion",
      "sourceFacing": "right",
      "mirror": true,
      "holdAsset": "done.webp"
    },
    "sleep": {
      "asset": "sleep.webp",
      "durationMs": 900,
      "role": "stationary",
      "sourceFacing": "right",
      "mirror": true
    },
    "wave": {
      "asset": "wave.webp",
      "durationMs": 900,
      "role": "stationary",
      "sourceFacing": "right",
      "mirror": true
    }
  },
  "states": {
    "idle": {
      "animation": "sleep",
      "action": "idle",
      "visible": true
    },
    "working": {
      "animation": "leaf-sway-step",
      "action": "walking"
    },
    "blocked": {
      "animation": "sprout-leaf",
      "action": "idle"
    },
    "done": {
      "animation": "sleep",
      "action": "idle"
    },
    "unknown": {
      "animation": "sleep",
      "action": "idle",
      "visible": true
    },
    "listening": {
      "animation": "sprout-leaf",
      "action": "idle"
    },
    "speaking": {
      "animation": "sprout-leaf",
      "action": "idle"
    }
  }
}
