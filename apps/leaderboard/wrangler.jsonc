{
  "name": "pet-town-leaderboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pet-town-leaderboard",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    },
  ],
}
