[navigation]

3d/default_cell_size=0.3
3d/merge_rasterizer_cell_scale=0.1

[physics]

common/physics_interpolation=true

[rendering]
rendering_device/driver.macos="metal"
anti_aliasing/quality/msaa_3d=0
scaling_3d/scale=0.8

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
limits/opengl/max_renderable_lights=256
environment/defaults/default_clear_color=Color(0.00396832, 0.01169353, 0.02033630, 1)
