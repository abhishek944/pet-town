{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@pet-town/leaderboard#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/pet-town/src/pets/**",
        "$TURBO_ROOT$/bin/macos-*/**"
      ],
      "outputs": []
    },
    "@pet-town/web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/pet-town-3d/**",
        "$TURBO_ROOT$/apps/pet-town/src/pets/**",
        "$TURBO_ROOT$/bin/macos-*/**"
      ],
      "outputs": ["dist/**"]
    },
    "@pet-town/desktop#internal:build-frontend": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/pet-town-3d/**",
        "$TURBO_ROOT$/scripts/build-pet-town-frontends.sh",
        "$TURBO_ROOT$/apps/pet-town/src/pets/**",
        "$TURBO_ROOT$/bin/macos-*/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"],
      "outputs": []
    },
    "@pet-town/desktop#lint:rust": {
      "dependsOn": ["internal:build-frontend", "^lint:rust"],
      "cache": false,
      "outputs": []
    },
    "@pet-town/desktop#check:rust": {
      "dependsOn": ["internal:build-frontend", "^check:rust"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
